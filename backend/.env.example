# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-string

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_HOURS=12
JWT_REFRESH_TOKEN_DAYS=30

# ---------------------------------------------------------------------------
# Database (Neon / any hosted Postgres)
#
# Grab the connection string from the Neon dashboard -> "Connection string".
# The `postgresql://` prefix is rewritten to `postgresql+psycopg://`
# automatically, and `sslmode=require` is appended if missing, so you can
# paste Neon's string verbatim.
#
# Use the *pooled* string (host contains `-pooler`) for the running app.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional: the *direct* (non-pooled) Neon string, used only by Alembic
# migrations. PgBouncer in transaction mode can interfere with DDL, so if you
# hit migration errors, set this to the connection string whose host has no
# `-pooler` segment. Leave blank to just reuse DATABASE_URL.
MIGRATION_DATABASE_URL=

# Local Postgres alternative, for reference:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_system

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Seed script demo accounts (seed.py). Change these before any real use.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@stockflow.test
SEED_ADMIN_PASSWORD=Admin@123
SEED_STAFF_EMAIL=staff@stockflow.test
SEED_STAFF_PASSWORD=Staff@123
